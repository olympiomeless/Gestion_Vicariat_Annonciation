# Copiez ce fichier vers .env et remplissez les vraies valeurs.
# Ne JAMAIS committer le fichier .env réel dans git.

# --- Base de données ---
# Exemple local :   postgresql+psycopg2://vicariat:motdepasse@localhost:5432/vicariat
# Exemple Render/Railway : utilisez l'URL fournie par le service PostgreSQL
DATABASE_URL=postgresql+psycopg2://vicariat:changeme@localhost:5432/vicariat

# --- Sécurité / JWT ---
# Générez une valeur aléatoire forte, par ex. : python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Compte administrateur initial (utilisé UNIQUEMENT par scripts/create_admin.py) ---
ADMIN_EMAIL=admin@vicariat-annonciation.example
# Ne mettez pas le mot de passe ici : le script create_admin.py le demandera de façon interactive
# ou lira ADMIN_INITIAL_PASSWORD si vous l'exportez temporairement dans votre shell (jamais dans .env versionné).

# --- Stockage des fichiers ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
MAX_UPLOAD_SIZE_MB=20

# --- CORS ---
# Domaines autorisés à appeler l'API (séparés par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Environnement ---
ENVIRONMENT=development
